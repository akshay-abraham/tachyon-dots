{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Tuned for kitty initial_window_width 125c: Fedora auto-logo (~43c) + padding (5c)
  // leaves a 77c-wide info block, so the two combined = 125c exactly.
  "logo": {
    "padding": { "top": 2, "left": 2, "right": 3 }
  },
  "display": {
    "disableLinewrap": true
  },
  "modules": [
    "break",
    "break",
    { "type": "custom", "format": "\u001b[90m┌─────────────────────────────────Hardware──────────────────────────────────┐" },
    { "type": "host", "key": " PC", "keyColor": "blue" },
    { "type": "cpu", "key": "│ ├", "showPeCoreCount": true, "keyColor": "blue" },
    { "type": "gpu", "key": "│ ├", "detectionMethod": "pci", "hideType": ["integrated"], "format": "{name}", "keyColor": "blue" },
    { "type": "display", "key": "│ ├󱄄", "keyColor": "blue" },
    { "type": "disk", "key": "│ ├󰋊", "keyColor": "blue" },
    { "type": "memory", "key": "│ ├", "keyColor": "blue" },
    { "type": "swap", "key": "└ └󰓡", "keyColor": "blue" },
    { "type": "custom", "format": "\u001b[90m└───────────────────────────────────────────────────────────────────────────┘" },
    "break",
    { "type": "custom", "format": "\u001b[90m┌─────────────────────────────────Software──────────────────────────────────┐" },
    { "type": "os", "key": " OS", "keyColor": "cyan" },
    { "type": "kernel", "key": "│ ├", "keyColor": "cyan" },
    { "type": "de", "key": "│ ├", "keyColor": "cyan" },
    { "type": "wm", "key": "│ ├", "keyColor": "cyan" },
    { "type": "wmtheme", "key": "│ ├󰉼", "keyColor": "cyan" },
    { "type": "terminal", "key": "│ ├", "keyColor": "cyan" },
    { "type": "terminalfont", "key": "│ ├", "keyColor": "cyan" },
    { "type": "shell", "key": "│ ├", "keyColor": "cyan" },
    { "type": "packages", "key": "│ ├󰏖", "keyColor": "cyan" },
    {
      "type": "command",
      "key": "│ ├",
      "keyColor": "cyan",
      "text": "command -v zed >/dev/null 2>&1 && echo Zed || echo N/A"
    },
    { "type": "icons", "key": "│ ├󰀻", "keyColor": "cyan" },
    { "type": "font", "key": "│ ├", "keyColor": "cyan" },
    { "type": "cursor", "key": "└ └󰇀", "keyColor": "cyan" },
    { "type": "custom", "format": "\u001b[90m└───────────────────────────────────────────────────────────────────────────┘" },
    "break",
    { "type": "custom", "format": "\u001b[90m┌────────────────────────────────System Info────────────────────────────────┐" },
    {
      "type": "command",
      "key": "󱦟 OS Age",
      "keyColor": "white",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },
    { "type": "uptime", "key": "│ ├󱫐", "keyColor": "white" },
    {
      "type": "command",
      "key": "└ └",
      "keyColor": "white",
      "text": "command -v dnf >/dev/null 2>&1 && echo \"$(dnf check-update -q 2>/dev/null | grep -c '^[a-zA-Z0-9]') pending\" || echo N/A"
    },
    { "type": "custom", "format": "\u001b[90m└───────────────────────────────────────────────────────────────────────────┘" },
    "break"
  ]
}
